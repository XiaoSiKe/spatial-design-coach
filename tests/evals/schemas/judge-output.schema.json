{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["judgments"],
  "additionalProperties": false,
  "properties": {
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "passed", "missing_must", "violated_must_not", "evidence", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "passed": {"type": "boolean"},
          "missing_must": {"type": "array", "items": {"type": "string"}},
          "violated_must_not": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
